# Elevate Lead Dispatcher: example environment.
# Development values only. Never put real secrets in this file.
# Copy to .env (bash: cp .env.example .env | PowerShell: Copy-Item .env.example .env).
# Phase 1 may refine this file together with env.ts.

NODE_ENV=development

# Database (inside docker compose the host is "db"; outside it is "localhost")
DB_PORT=5432
POSTGRES_USER=elevate
POSTGRES_PASSWORD=elevate
POSTGRES_DB=elevate
DATABASE_URL=postgres://elevate:elevate@localhost:5432/elevate
TEST_DATABASE_URL=postgres://elevate:elevate@localhost:5432/elevate_test

# API
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info
APP_TIMEZONE=America/Sao_Paulo
DEFAULT_PHONE_REGION=BR
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
WEBHOOK_TOLERANCE_SECONDS=300
DISPATCH_LOCK_TIMEOUT_MS=3000

# Rate limits (requests per minute per IP)
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LEADS_PER_MIN=60
RATE_LIMIT_WEBHOOK_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=5

# Web
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:3001

# Demo seed (development only)
SEED_DEMO=true
