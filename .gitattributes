# Force LF in the repository and in the working tree (Windows author, Linux containers).
* text=auto eol=lf

*.sh text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
