{
  "name": "elevate-lead-dispatcher",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "npm run dev -w @elevate/api",
    "dev:web": "npm run dev -w @elevate/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w @elevate/api",
    "db:generate": "npm run db:generate -w @elevate/api",
    "db:migrate": "npm run db:migrate -w @elevate/api",
    "db:seed": "npm run db:seed -w @elevate/api",
    "db:seed-bulk": "npm run db:seed-bulk -w @elevate/api",
    "db:explain": "node --env-file-if-exists=.env scripts/explain-queries.mjs",
    "load:leads": "node --env-file-if-exists=.env scripts/load-leads.mjs",
    "webhook:send": "node --env-file-if-exists=.env scripts/send-webhook.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
